# LLM provider for the analyst
# Provider: "openrouter" or "ollama" (defaults to config.json)
LLM_PROVIDER=ollama
# Model name (e.g. qwen2.5:7b for Ollama, or openai/gpt-4o-mini for OpenRouter)
LLM_MODEL=llama3.2
# Base URL for the provider (Ollama default: http://127.0.0.1:11434)
LLM_BASE_URL=http://127.0.0.1:11434
# Optional: sampling temperature (0-2)
# LLM_TEMPERATURE=0

# API key for OpenRouter (only needed when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Whisper model / device / compute type
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional: override the Python binary used to launch the WhisperX server.
# By default the app uses the venv created by `npm install`
# (packages/transcriber/whisper/.venv/bin/python). Only set this to use a
# different interpreter (e.g. a system python with whisperx installed).
# PYTHON_BIN=python3

# Audio capture
CAPTURE_MICROPHONE=true
CAPTURE_SYSTEM_AUDIO=true
CAPTURE_APPS=Brave Browser,Google Chrome,Safari,Music,Spotify
