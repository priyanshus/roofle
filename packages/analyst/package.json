{
  "name": "@roofle/analyst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:prompts",
    "copy:prompts": "mkdir -p dist/agent/prompts && cp src/agent/prompts/*.txt dist/agent/prompts/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.10",
    "@roofle/shared": "0.1.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "typescript": "^5.9.3"
  }
}
