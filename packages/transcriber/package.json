    "node-addon-api": "^7.1.1",
    "node-gyp-build": "^4.8.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/ws": "^8.18.1",
    "node-gyp": "^11.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
