STT_WS_URL=ws://127.0.0.1:9000
# STT_WS_TOKEN=
# Capture system audio from app
CAPTURE_APPS=Brave Browser
# Capture the microphone and/or system audio. Both default to on.
CAPTURE_MICROPHONE=true
CAPTURE_SYSTEM_AUDIO=true
# Voice Activity Detection: skip silence before sending to STT.
VAD_ENABLED=true
# Echo suppression: mute the mic while system audio (speaker) is playing, so
# the speaker's audio isn't re-transcribed as the user's mic (echo). The mic
# is allowed through again after the speaker goes silent (plus a hangover).
ECHO_SUPPRESSION_ENABLED=true
# Show full STT JSON payload + periodic metrics. Default off (text only).
LOG_METRICS=false

# --- Whisper server latency tuning (whisper/server.py) ---
# Rolling window fed to the model (seconds). Smaller = faster inference.
WINDOW_SECONDS=4
# How often the server attempts inference (ms).
TRANSCRIBE_INTERVAL_MS=100
# Minimum buffered audio before inference runs (seconds).
MIN_AUDIO_SECONDS=0.3
# RMS below this is treated as silence and skipped (avoids "_" partials).
VAD_THRESHOLD=0.01
# Silence gap (ms) after which a phrase is finalized and shown once.
PAUSE_FINALIZE_MS=400
